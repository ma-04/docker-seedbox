# Keep the build context small and free of secrets. Each Dockerfile copies only what it needs.
**/node_modules
**/dist
**/coverage
.git
.github
credentials
**/.env
**/.env.*
!**/.env.example
**/*.log
# e2e artifacts
e2e/test-results
e2e/playwright-report
e2e/.cache
e2e/live/.state
# docs
docs
*.md
.DS_Store
