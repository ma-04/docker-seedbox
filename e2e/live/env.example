# Copy to a git-ignored place (default lookup: <repo>/credentials/deploy.env, or LIVE_ENV_FILE=/path) and fill in.
LIVE_DOMAIN=seedbox.example.com            # app host; auth.<domain> and files.<domain> are derived (LIVE_AUTH_HOST / LIVE_FILES_HOST override)
LIVE_ADMIN_USER=admin
LIVE_ADMIN_PASSWORD=
LIVE_USER=tester                           # a normal (non-admin) user: ./setup.sh add-user
LIVE_USER_PASSWORD=
LIVE_SSH_TARGET=user@203.0.113.10          # the Docker host (out-of-band probes, restarts)
LIVE_SSH_KEY=~/.ssh/id_ed25519
LIVE_REMOTE_DIR=docker-seedbox             # checkout directory on the host, relative to the ssh user's home
LIVE_WG_CONFIGS=/path/wg01.conf,/path/wg02.conf   # two WireGuard configs from your provider
LIVE_RCLONE_CONF=/path/rclone.conf         # holds the Drive remote and the B2 remote (read locally, never copied anywhere)
LIVE_GDRIVE_REMOTE=my-drive                # rclone remote name, type drive
LIVE_DRIVE_ROOT_FOLDER_ID=                 # a folder this OAuth client can see (see the note about the drive.file scope)
LIVE_PROXY_URL=https://seedbox-drive-proxy.example.workers.dev
LIVE_PROXY_ENV=/path/drive-proxy.env       # a file with SIGNING_KEY=<the Worker's signing key>
LIVE_B2_REMOTE=my-b2                       # rclone remote name, type b2 (account = keyID, key = applicationKey)
LIVE_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
LIVE_S3_REGION=us-west-004
LIVE_S3_BUCKET=my-bucket
LIVE_S3_PREFIX_BASE=seedbox-test           # the suite writes and deletes ONLY below <base>/<run-id>/
LIVE_WEBSEEDS=                            # 1 = add the distros' HTTPS mirrors as web seeds (for VPNs that block BitTorrent peers); infohash unchanged
LIVE_WEBSEEDS_UBUNTU=                      # optional extra mirror directory URLs (comma separated) used as web seeds when LIVE_WEBSEEDS=1
LIVE_WEBSEEDS_DEBIAN=
