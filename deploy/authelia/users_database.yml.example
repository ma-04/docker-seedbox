# Authelia file-based users. setup.sh generates deploy/authelia/users/users_database.yml
# (git-ignored); this file only documents the format.
#
# Generate a password hash with the pinned Authelia image:
#   docker run --rm authelia/authelia:4.39.28 authelia crypto hash generate argon2 --password 'change-me'
#
# Groups: members of "admins" can open the Admin pages (ADMIN_GROUP in .env).
users:
  admin:
    disabled: false
    displayname: 'Admin'
    email: 'admin@example.com'
    password: '$argon2id$v=19$m=65536,t=3,p=4$REPLACE_WITH_A_REAL_HASH'
    groups:
      - 'admins'
      - 'users'
  alice:
    disabled: false
    displayname: 'Alice'
    email: 'alice@example.com'
    password: '$argon2id$v=19$m=65536,t=3,p=4$REPLACE_WITH_A_REAL_HASH'
    groups:
      - 'users'
