# docker-seedbox deployment settings. ./setup.sh creates deploy/.env from this
# (and generates every secret); you normally never edit this file by hand.
# Full reference: docs/configuration.md

# --- Hosts (no scheme). Three DNS records pointing at this server. -------------------
APP_HOST=seedbox.example.com
AUTH_HOST=auth.seedbox.example.com
FILES_HOST=files.seedbox.example.com
# Parent domain that covers APP_HOST and AUTH_HOST (Authelia session cookie).
COOKIE_DOMAIN=seedbox.example.com

# --- Which compose files / profiles to use (set by setup.sh) -------------------------
# Proxy mode: compose.proxy-bundled.yaml | compose.proxy-external.yaml | compose.proxy-none.yaml
COMPOSE_FILE=compose.yaml:compose.proxy-bundled.yaml
# "authelia" starts the login portal; remove it when AUTH_MODE=external.
COMPOSE_PROFILES=authelia
#COMPOSE_PROJECT_NAME=seedbox

# --- Images ---------------------------------------------------------------------------
SEEDBOX_REGISTRY=ghcr.io/ma-04
SEEDBOX_VERSION=latest

# --- Auth -----------------------------------------------------------------------------
# authelia: built-in login portal. external: you run your own SSO proxy in front of the
# gateway (it must set Remote-User/Groups/Email/Name and be the ONLY way to reach it).
AUTH_MODE=authelia
AUTH_POLICY=one_factor
ADMIN_GROUP=admins

# --- Proxy mode specifics -------------------------------------------------------------
ACME_EMAIL=
# external mode: name of the Docker network your existing reverse proxy is on.
PROXY_NETWORK=
# none mode: where the gateway is published on the host.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# --- Runtime --------------------------------------------------------------------------
PUBLIC_SCHEME=https
LOG_LEVEL=info
# Fixed subnet of the internal Docker network (the VPN kill switch allows it).
LAN_CIDRS=172.31.250.0/24
# Static addresses of api and worker inside LAN_CIDRS (high end, so Docker's dynamic allocation never takes them).
# They are the ONLY addresses allowed to use qBittorrent's WebUI without a password. Change together with LAN_CIDRS.
#API_IP=172.31.250.250
#WORKER_IP=172.31.250.251
# Mode the VPN sidecar starts in after every (re)start, until the worker applies the admin's vpn.mode:
# required = fail closed (no traffic outside the tunnel; the safe default), off = open.
#VPN_DEFAULT_MODE=required

# --- Secrets (generated by setup.sh, never commit) ------------------------------------
APP_SECRET=
GATEWAY_SECRET=
VPN_CONTROL_TOKEN=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_JWT_SECRET=
