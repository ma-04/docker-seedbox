# Rendered by the nginx image's envsubst step. Substituted: APP_HOST GATEWAY_SECRET. The layout-dependent parts
# (login portal, downloads, extra hosts) are generated by 25-gateway-auth-mode.sh into /tmp/gateway/.
# Everything else ($vars) is plain nginx.

# --- trust the outer TLS proxy (nginx-proxy / Traefik / Caddy / tunnel) --------------------
# Only private ranges are trusted to supply X-Forwarded-For. Publish the gateway to the
# internet directly and a client could lie about its address; it cannot lie about auth.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from fc00::/7;
set_real_ip_from 127.0.0.1;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

map $http_x_forwarded_proto $fwd_proto {
  default $scheme;
  https   https;
  http    http;
}
map $fwd_proto $hsts {
  default "";
  https   "max-age=31536000";
}
map "" $gateway_secret {
  default "${GATEWAY_SECRET}";
}

# No query strings in logs, on every server (this is the http-level default): download signatures, magnet links
# (/add?magnet=...) and Authelia's rd= redirect targets all travel in the query. $uri is the path only.
log_format noquery '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';
access_log /dev/stdout noquery;

# --- anything with an unknown Host ------------------------------------------------------
server {
  listen 8080 default_server;
  server_name _;
  server_tokens off;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }
  location / { return 404; }
}

# --- APP_HOST: SPA + /api (+ /auth/ and /dl/ in the single-domain layout) ---------------------------
server {
  listen 8080;
  server_name ${APP_HOST};
  server_tokens off;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Authelia sub-request target (unused in AUTH_MODE=external).
  location = /internal/authelia/authz {
    internal;
    set $upstream_authelia http://authelia:9091/api/authz/auth-request;
    proxy_pass $upstream_authelia;
    proxy_pass_request_body off;
    client_max_body_size 0;   # the sub-request inherits the body size check; the real limit is per-location
    proxy_http_version 1.1;
    proxy_set_header Content-Length "";
    proxy_set_header Connection "";
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Original-URL $fwd_proto://$host$request_uri;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
  }

  # Health probe: no login.
  location = /api/health {
    include /etc/nginx/snippets/proxy-common.conf;
    include /etc/nginx/snippets/remote-clear.conf;
    include /etc/nginx/snippets/to-api.conf;
    include /etc/nginx/snippets/security-headers.conf;
    set $api_upstream http://api:3000;
    proxy_pass $api_upstream;
  }

  # Server-sent events: no buffering, long-lived.
  location = /api/events {
    include /etc/nginx/snippets/proxy-common.conf;
    include /tmp/gateway/auth-api.conf;
    include /etc/nginx/snippets/to-api.conf;
    include /etc/nginx/snippets/security-headers.conf;
    add_header X-Accel-Buffering "no" always;   # also stops an outer nginx from buffering
    set $api_upstream http://api:3000;
    proxy_pass $api_upstream;
    proxy_buffering off;
    proxy_cache off;
    gzip off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  location /api/ {
    include /etc/nginx/snippets/proxy-common.conf;
    include /tmp/gateway/auth-api.conf;
    include /etc/nginx/snippets/to-api.conf;
    include /etc/nginx/snippets/security-headers.conf;
    client_max_body_size 10m;                   # .torrent uploads
    set $api_upstream http://api:3000;
    proxy_pass $api_upstream;
    proxy_read_timeout 120s;
  }

  location / {
    include /etc/nginx/snippets/proxy-common.conf;
    include /tmp/gateway/auth-page.conf;
    include /etc/nginx/snippets/security-headers.conf;
    proxy_set_header X-Gateway-Secret "";
    set $web_upstream http://web:8080;
    proxy_pass $web_upstream;
  }

  # Single-domain layout: Authelia under /auth/ and/or downloads under /dl/ (or a 404 for /dl/ when downloads have
  # their own host). Rendered by 25-gateway-auth-mode.sh.
  include /tmp/gateway/app-locations.conf;
}

# --- separate login / download hosts (AUTH_HOST, FILES_HOST), when configured -------------------------------
# Rendered by 25-gateway-auth-mode.sh from snippets/server-{auth,files}.conf.in; empty in the single-domain layout.
include /tmp/gateway/servers.conf;
