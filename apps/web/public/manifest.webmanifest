{
  "name": "docker-seedbox",
  "short_name": "seedbox",
  "description": "Torrent-to-cloud downloads",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0f172a",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "protocol_handlers": [
    { "protocol": "magnet", "url": "/add?magnet=%s" }
  ]
}
